import pandas as pd
import matplotlib.pyplot as plt

# Step 1: Import CSV file
data = pd.read_csv("storytelling.txt")

# Step 2: Display the data
print("Original Data:")
print(data)

# Step 3: Select the required columns
selected_data = data[
    ["Order ID", "Category", "Region", "Quantity", "Sales"]
]

# Step 4: Create a Bar Plot
selected_data.groupby("Category")["Sales"].sum().plot(
    kind="bar",
    title="Sales by Category"
)
plt.xlabel("Category")
plt.ylabel("Sales")
plt.show()

# Step 5: Create a Scatter Plot
plt.scatter(selected_data["Sales"], selected_data["Quantity"])
plt.title("Sales vs Quantity")
plt.xlabel("Sales")
plt.ylabel("Quantity")
plt.show()

# Step 6: Create a Line Plot
selected_data.groupby("Category")["Sales"].sum().plot(
    kind="line",
    marker="o",
    title="Sales Trend by Category"
)
plt.xlabel("Category")
plt.ylabel("Sales")
plt.show()
